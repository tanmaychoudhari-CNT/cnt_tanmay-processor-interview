# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/card_processor

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Default admin (seeded on first startup if no user exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# CORS: comma-separated origins the frontend will call from
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
